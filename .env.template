# JWT & Security Configuration
# Mandatory in production: Must be a cryptographically random secret of at least 64 bytes
JWT_SECRET=your_64_byte_random_secret_key_here_must_be_at_least_64_bytes_long

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=https://vixiem.vercel.app,http://localhost:5173

# Cookie Security Configuration (Set APP_COOKIE_SECURE=false and APP_COOKIE_SAME_SITE=Lax for local HTTP testing)
APP_COOKIE_SECURE=true
APP_COOKIE_SAME_SITE=None

# AI Configuration
GROQ_API_KEY=your_groq_api_key_here
RESEND_API_KEY=your_resend_api_key_here

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id_here

# Email Configuration for Alerting System
# Create an App Password if using Gmail. Do NOT use your real login password.
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

